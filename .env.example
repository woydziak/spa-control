# Copy to .env for a checkout, or to /etc/spa-control.env on the LXC.
# Values already set in the environment win over this file.
# Do not commit .env or /var/lib/spa-control/config.json.

# Wi-Fi module address. 192.0.2.10 is a documentation address; replace it.
SPA_HOST=192.0.2.10
SPA_PORT=4257
# Optional full MAC, lowercase, with colons. Logged if the module disagrees.
SPA_MAC=

SPA_LABEL=Spa
SPA_BIND=0.0.0.0
SPA_HTTP_PORT=8080
SPA_CONFIG=/var/lib/spa-control/config.json

# Stored only. The page does not enforce it yet.
SPA_PIN=

# Set to 1 to run the UI with no spa hardware.
SPA_MOCK=
